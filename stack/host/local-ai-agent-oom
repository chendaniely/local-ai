#!/bin/sh
# local-ai-agent-oom: agent's processes get an OOM score that root sets and agent can't lower (Phase 2a, Task 28).
# Bootstrap installs it as /usr/local/libexec/local-ai-agent-oom, root's 0755, and puts this line before the first
# session line of /etc/pam.d/sshd:
#   session optional pam_exec.so /usr/local/libexec/local-ai-agent-oom
# pam_exec runs it as root at every sshd session's open and close. For agent's open_session only, it writes
# AGENT_OOM_SCORE_ADJ to its parent's oom_score_adj. Its parent is sshd's privileged process for that login, which
# forks agent's shell afterwards. A write by root sets the floor too (the kernel's oom_score_adj_min), which every
# process forked from it inherits and can't go under: agent's shell, tmux and every job. For anyone else, and for any
# other PAM_TYPE, it exits 0 at once. agent's user manager gets the same value from its drop-in, agent-oom.conf.
#
# It runs as root, in an environment it doesn't choose. pam_exec hands it the PAM environment, and a user can fill
# that: sshd's own stack has `pam_env.so user_readenv=1`, which reads the user's ~/.pam_environment. So:
#   - The line comes before sshd's first session line, where nothing a user supplies is in that environment yet.
#     Bootstrap refuses to put it after any pam_env line that reads a user's file. A shell started with a user's
#     LD_PRELOAD would run that user's code before this file's first line.
#   - It runs shell builtins only, with PATH fixed and IFS reset.
#   - It reads no variable but PAM_USER, PAM_TYPE and the shell's own PPID, and sets every other name it uses.
#   - It reads no input: nothing on stdin, and no file but its parent's comm and the score it wrote.
#   - It writes one file, its parent's oom_score_adj, and only once its parent is past PID 1 and is sshd. That is
#     comm `sshd`, or `sshd-session` from OpenSSH 9.8 on. It never writes PID 1's, which every service PID 1 starts
#     later would inherit.
#
# Exit status:
#   - 0 for anyone but agent, for any PAM_TYPE but open_session, and once agent's score is written.
#   - 1 when agent's open_session can't be given it: a parent that isn't sshd or is PID 1, or a write that didn't take.
# The line is `optional`, so 1 never stops the login. pam_exec writes the exit code to the journal and shows it at
# the login. The tests run a copy with the PROC line (and, for PID 1, the PARENT line) replaced; this file has no
# switch.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset IFS

# AGENT_OOM_SCORE_ADJ: 1000, the top of the range (the controller's ruling, 2026-10-14). The kernel's score, as
# /proc/<pid>/oom_score shows it and earlyoom reads it, is
#   (1000 + 1000 * RSS / (RAM + swap) + oom_score_adj) * 2 / 3,
# with RSS counting swap and page tables too. Checked on brightroar on 2026-10-14, with RAM 121.6 GiB and swap
# 16 GiB: a llama-server at adj 1000 holding 2,643,628 kB of RSS read 1345, as the formula gives.
#
# spark launch runs the engines at 1000 (on demand) and 900 (resident), and their GPU memory isn't in their RSS.
# earlyoom's --prefer added 300 to that score, worth 450 points of adj after the 2/3. That put every engine above
# anything at 1000, so Task 28 took --prefer out of earlyoom.default. Now, for an engine holding 2% of RAM, the
# score is 1344 on demand and 1278 resident. Against those:
#   - A job of agent's holding a tenth of RAM scores 1392, so earlyoom, like the kernel, takes it first. At 1000, it
#     passes the on-demand engine once it holds more than that engine does: about 2.5 GiB here.
#   - An empty process of agent's scores 1332: below the on-demand engine, above a resident.
#   - A process of Dan's at 0 holding 90% of RAM scores 1196, still below every engine.
AGENT_OOM_SCORE_ADJ=1000

PROC=/proc
PARENT=$PPID

[ "${PAM_USER-}" = agent ] || exit 0
[ "${PAM_TYPE-}" = open_session ] || exit 0

case $PARENT in
    '' | *[!0-9]*) exit 1 ;;
esac
[ "$PARENT" -gt 1 ] || exit 1
comm=
read -r comm 2>/dev/null <"$PROC/$PARENT/comm"
case $comm in
    sshd | sshd-session) ;;
    *) exit 1 ;;
esac
printf '%s\n' "$AGENT_OOM_SCORE_ADJ" 2>/dev/null >"$PROC/$PARENT/oom_score_adj" || exit 1
now=
read -r now 2>/dev/null <"$PROC/$PARENT/oom_score_adj"
[ "$now" = "$AGENT_OOM_SCORE_ADJ" ] || exit 1
exit 0
