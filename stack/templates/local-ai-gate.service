# Rendered by `spark render` — edit stack/templates/, not this file.
[Unit]
Description=local-ai: the gate, on its two Unix sockets
After=local-ai-llama-swap.service
# Never gives up, and the failure notifier says when it fails.
StartLimitIntervalSec=0
OnFailure=local-ai-notify@%n.service

[Service]
# notify: READY=1 once it serves, and a hang becomes a failure through the watchdog (spark.sdnotify).
Type=notify
WatchdogSec=30
User=spark
Group=spark
# Passed by their names, status and control (spark.sockets).
Sockets=local-ai-gate-status.socket local-ai-gate-control.socket
# Its own key for llama-swap, its ntfy token's header and the private key list: never in the environment
# (spark.credentials). Until Task 2 writes the header (Phase 5), ntfy-token is SetCredential='s placeholder, which
# isn't a header line, so the gate serves without ntfy; with the file there, the file wins (systemd.exec(5)).
LoadCredential=llamaswap-key:/etc/local-ai/secrets/gate.key
LoadCredential=ntfy-token:/etc/local-ai/secrets/ntfy-gate.header
SetCredential=ntfy-token:not-set-up
LoadCredential=keys:/etc/local-ai/keys.yaml
# NTFY_URL and NTFY_TOPIC_GATE; the - lets a missing file pass, which is 2a's state until Task 2.
EnvironmentFile=-/etc/local-ai/values.env
Environment=SPARK_REGISTRY=/opt/local-ai/etc/models.yaml
Environment=SPARK_STATE=/var/lib/local-ai/brake
Environment=SPARK_GATE_STATE=/var/lib/local-ai/gate
Environment=SPARK_LAUNCH=/var/lib/local-ai/launch
Environment=SPARK_LLAMASWAP_URL=http://{llamaswap_listen}
Environment=HF_HOME=/var/lib/local-ai/hf
ExecStart=/opt/local-ai/app/.venv/bin/spark gate
Restart=always
RestartSec=2
# Its stop at worst: uvicorn's grace (gateproto.GRACEFUL_S, 20 s), the bounded routes' work still running past its 503
# (gate.app.FINISH_WORK_S, 2 s), ntfy's last publish (gateproto.NTFY_TIMEOUT_S, 5 s) and its ledger's last rows
# (gate.main.LEDGER_DRAIN_S, 2 s): about 29 s.
TimeoutStopSec=45
OOMScoreAdjust=-900
# Writable: its own state, launch's tickets, the brake's hold, which it lifts (rule 5), and its ledger, Dan's to read
# (the - lets a missing folder pass). No PrivateDevices=,
# ProtectProc= or ProcSubset=: nvidia-smi needs the GPU's device nodes, and the gate reads the engines' and Dan's
# processes in /proc.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/local-ai/gate /var/lib/local-ai/launch /var/lib/local-ai/brake -/var/lib/local-ai/gate-ledger
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
