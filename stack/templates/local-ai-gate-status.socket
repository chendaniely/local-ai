# Rendered by `spark render` — edit stack/templates/, not this file.
[Unit]
Description=local-ai: the gate's status socket, for spark-users

[Socket]
# The front, the CLI's status and sessions, and agent connect here; the gate knows each caller by its uid.
ListenStream=/run/local-ai/gate-status.sock
SocketUser=spark
SocketGroup=spark-users
SocketMode=0660
FileDescriptorName=status
# Never gives up: however often it starts the gate, a crash loop's included, it never trips the trigger limit,
# which would leave it no longer listening until restarted (systemd.socket(5)).
TriggerLimitIntervalSec=0
Service=local-ai-gate.service

[Install]
WantedBy=sockets.target
